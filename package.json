    "lucide-react": "^1.8.0",
    "next": "16.2.6",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.19.1",
    "prom-client": "^15.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
